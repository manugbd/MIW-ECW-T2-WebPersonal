{% macro icon(name) %}
<img src="{{ ('/img/icons/' ~ name ~ '.svg') | url }}" width="18" height="18" alt="" aria-hidden="true">
{% endmacro %}

{% macro email(address, key, copy=false) %}
{% if copy %}<span data-email-group>{% endif %}
<span data-help>
  <a href="mailto:{{ address }}" aria-describedby="correo-{{ key }}">{{ address }}</a>
  <span role="tooltip" id="correo-{{ key }}" hidden>Abrir correo en la aplicación</span>
</span>
{% if copy %}
<span data-help>
  <button type="button" data-copy-email="{{ address }}" aria-label="Copiar {{ address }}"
    aria-describedby="copiar-{{ key }}" hidden>{{ icon('copy') }}</button>
  <span role="tooltip" id="copiar-{{ key }}" hidden>Copiar correo</span>
</span></span>{% endif %}
{% endmacro %}

{% macro social(url, name, kind, key, help, label=true) %}
<span data-help>
  <a href="{{ url }}" data-social aria-describedby="red-{{ key }}">
    {{ icon(kind) }}
    {% if label %}
    <span>{{ 'GitHub:' if kind == 'github' else 'LinkedIn:' }}</span>
    {% endif %}
    <span>{{ name }}</span>
  </a>
  <span role="tooltip" id="red-{{ key }}" hidden>{{ help }}</span>
</span>
{% endmacro %}