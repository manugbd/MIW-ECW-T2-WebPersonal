{% from "contacto.njk" import email, icon, social with context %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description | escape }}">
  <link rel="icon" href="{{ '/favicon.ico' | url }}">
  <meta name="author" content="{{ site.name }}">
  <title>{{ seoTitle or (title ~ ' | ' ~ site.name) }}</title>
  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  {% if site.url and not noindex %}
  <link rel="canonical" href="{{ page.url | absoluteUrl }}">
  {% for language in i18n.locales %}
  <link rel="alternate" hreflang="{{ language.code }}" href="{{ i18n.routes[translationKey][language.code] | absoluteUrl }}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ i18n.routes[translationKey].es | absoluteUrl }}">
  <meta property="og:type" content="{{ 'profile' if translationKey == 'profile' else 'website' }}">
  <meta property="og:locale" content="{{ locale.og }}">
  {% for language in i18n.locales %}{% if language.code != lang %}
  <meta property="og:locale:alternate" content="{{ language.og }}">
  {% endif %}{% endfor %}
  <meta property="og:site_name" content="{{ site.name }} — {{ t.personalSite }}">
  <meta property="og:title" content="{{ (seoTitle or (title ~ ' | ' ~ site.name)) | escape }}">
  <meta property="og:description" content="{{ description | escape }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl }}">
  <meta property="og:image" content="{{ site.image | absoluteUrl }}">
  <meta property="og:image:alt" content="{{ t.imageAlt }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ (seoTitle or (title ~ ' | ' ~ site.name)) | escape }}">
  <meta name="twitter:description" content="{{ description | escape }}">
  <meta name="twitter:image" content="{{ site.image | absoluteUrl }}">
  <meta name="twitter:image:alt" content="{{ t.imageAlt }}">
  <meta name="google-site-verification" content="DttKDazyyCJv4j2IU443DcO6_MISbrQix5wjIcHTh7M">
  <script type="application/ld+json">{{ {page: page, title: title, seoTitle: seoTitle, description: description, breadcrumb: breadcrumb, lang: lang, translationKey: translationKey} | structuredData | jsonLd | safe }}</script>
  {% endif %}
  <link rel="stylesheet" href="{{ '/css/colores.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/base.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/header.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/footer.css' | url }}">
  {% set pageStyles = {home: 'inicio', profile: 'perfil', projects: 'proyectos', interests: 'intereses', leisure: 'intereses'} %}
  {% if pageStyles[translationKey] %}
  <link rel="stylesheet" href="{{ ('/css/' ~ pageStyles[translationKey] ~ '.css') | url }}">
  {% endif %}
</head>
<body>
  <a href="#contenido-principal">{{ t.skip }}</a>
  <header>
    <nav aria-label="{{ t.identity }}">
      <a href="{{ i18n.routes.home[lang] | url }}">
        <span>{{ site.name }}</span>
        <span>{{ t.personalSite }}</span>
      </a>
    </nav>
    <button type="button" hidden aria-expanded="false" aria-controls="navegacion-principal" aria-describedby="ayuda-menu">
      <span aria-hidden="true">&#9776;</span><span>{{ t.menu }}</span>
    </button>
    <span id="ayuda-menu" role="tooltip" hidden>{{ t.menuHelp }}</span>
    <nav id="navegacion-principal" aria-label="{{ t.mainNav }}">
      <ul>
        {% for key in ['home', 'profile', 'projects', 'interests', 'leisure'] %}
        <li><a href="{{ i18n.routes[key][lang] | url }}"{% if translationKey == key %} aria-current="page"{% endif %}>{{ t[key] }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <details data-language>
      <summary aria-label="{{ t.languageNav }}: {{ locale.name }}">
        {{ icon('language') }} <span>{{ locale.name }}</span>
      </summary>
      <ul aria-label="{{ t.languageNav }}">
        {% for language in i18n.locales %}
        <li><a href="{{ i18n.routes[translationKey][language.code] | url }}" lang="{{ language.code }}" hreflang="{{ language.code }}"{% if language.code == lang %} aria-current="true"{% endif %}>{{ language.name }}</a></li>
        {% endfor %}
      </ul>
    </details>
  </header>
  <main id="contenido-principal">
    <nav aria-label="{{ t.breadcrumbs }}">
      <ol>
        <li>{% if translationKey == 'home' %}<span aria-current="page">{{ t.home }}</span>{% else %}<a href="{{ i18n.routes.home[lang] | url }}">{{ t.home }}</a>{% endif %}</li>
        {% if translationKey != 'home' %}<li><span aria-current="page">{{ breadcrumb or title }}</span></li>{% endif %}
      </ol>
    </nav>
    {{ content | safe }}
  </main>
  <footer>
    <section>
      <h2>{{ site.name }}</h2>
      <p>{{ t.footerIntro }} <em>{{ t.course }}</em> {{ t.footerEnd }}</p>
    </section>
    <section aria-labelledby="titulo-contacto">
      <h2 id="titulo-contacto">{{ t.contact }}</h2>
      <address>
        <p>{{ icon('location') }} {{ t.location }}</p>
        <p>{{ icon('mail') }} {{ t.university }}: {{ email('uo295497@uniovi.es', 'pie-universidad', true) }}</p>
        <p>{{ icon('mail') }} {{ t.personal }}: {{ email('garciabaldo04@gmail.com', 'pie-personal', true) }}</p>
        <p>{{ social('https://github.com/manugbd', 'manugbd', 'github', 'github', t.openGithub) }}</p>
        <p>{{ social('https://www.linkedin.com/', site.name, 'linkedin', 'linkedin', t.openLinkedin) }}</p>
      </address>
      <p role="status" aria-live="polite" aria-atomic="true" data-copy-status data-copying="{{ t.copying }}" data-copied="{{ t.copied }}" data-copy-error="{{ t.copyError }}"></p>
    </section>
    <nav aria-labelledby="titulo-mapa">
      <h2 id="titulo-mapa">{{ t.map }}</h2>
      <ul>
        {% for key in ['home', 'profile', 'projects', 'interests', 'leisure'] %}
        <li><a href="{{ i18n.routes[key][lang] | url }}">{{ t[key] }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <details>
      <summary>{{ t.help }}</summary>
      <p>{{ t.helpNav }}</p>
      <p>{{ t.helpProfile }} <a href="{{ i18n.routes.profile[lang] | url }}">{{ t.profile }}</a>. {{ t.helpProjects }} <a href="{{ i18n.routes.projects[lang] | url }}">{{ t.projects }}</a>.</p>
      <p>{{ t.helpKeys }}</p>
      <p>{{ t.helpContact }}</p>
    </details>
    <p>
      <span>&copy; <time data-copyright datetime="2026">2026</time> {{ site.name }}. {{ t.rights }}</span>
      <span>{{ t.updated }}: <time datetime="{{ site.updated }}">{{ updatedLabel }}</time>.</span>
    </p>
  </footer>
  <script src="{{ '/js/main.js' | url }}" defer></script>
</body>
</html>
