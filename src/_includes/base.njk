<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description }}">
  <title>{{ title }} | Manuel García Baldó - Web personal</title>
  <link rel="stylesheet" href="/css/colores.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  {% if page.url == "/" %}
  <link rel="stylesheet" href="/css/inicio.css">
  {% elif page.url == "/perfil/" %}
  <link rel="stylesheet" href="/css/perfil.css">
  {% elif page.url == "/proyectos/" %}
  <link rel="stylesheet" href="/css/proyectos.css">
  {% elif page.url == "/intereses-profesionales/" %}
<link rel="stylesheet" href="/css/intereses.css">
{% elif page.url == "/ocio/" %}
<link rel="stylesheet" href="/css/intereses.css">
{% endif %}
</head>

<body>
  <a href="#contenido-principal">Saltar al contenido principal</a>

  <header>
    <nav aria-label="Identidad del sitio">
      <a href="/">
        <span>Manuel García Baldó</span>
        <span>Web personal</span>
      </a>
    </nav>

    <nav aria-label="Navegación principal">
      <ul>
        <li><a href="/" {% if page.url=="/" %}aria-current="page" {% endif %}>Inicio</a></li>
        <li><a href="/perfil/" {% if page.url=="/perfil/" %}aria-current="page" {% endif %}>Mi perfil</a></li>
        <li><a href="/proyectos/" {% if page.url=="/proyectos/" %}aria-current="page" {% endif %}>Proyectos</a></li>
        <li><a href="/intereses-profesionales/" {% if page.url=="/intereses-profesionales/" %}aria-current="page" {% endif %}>Intereses tecnológicos</a></li>
        <li><a href="/ocio/" {% if page.url=="/ocio/" %}aria-current="page" {% endif %}>Ocio</a></li>
      </ul>
    </nav>
  </header>

  <main id="contenido-principal">
    <nav aria-label="Migas de pan">
      <ol>
        <li>
          {% if page.url == "/" %}
          <span aria-current="page">Inicio</span>
          {% else %}
          <a href="/">Inicio</a>
          {% endif %}
        </li>
        {% if breadcrumb and page.url != "/" %}
        <li>
          <span aria-current="page">{{ breadcrumb }}</span>
        </li>
        {% endif %}
      </ol>
    </nav>

    {{ content | safe }}
  </main>

  <footer>
    <section>
      <h2>Manuel García Baldó</h2>
      <p>
        Sitio web personal y académico desarrollado para la asignatura
        <em>Estándares y Computación Web (ECW)</em> 
        del Máster Universitario en Ingeniería Web (Universidad de Oviedo).
      </p>
    </section>

    <section aria-labelledby="titulo-contacto">
      <h2 id="titulo-contacto">Contacto y Redes</h2>
      <address>
        <p>Ubicación: Gijón, Asturias, España</p>
        <p>Correo público: <a href="mailto:uo295497@uniovi.es">uo295497@uniovi.es</a></p>
        <p>GitHub: <a href="https://github.com/manugbd" target="_blank" rel="noopener noreferrer">github.com/manugbd</a>
        </p>
      </address>
    </section>

    <nav aria-labelledby="titulo-mapa">
      <h2 id="titulo-mapa">Mapa del sitio</h2>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/perfil/">Mi perfil y CV</a></li>
        <li><a href="/proyectos/">Proyectos</a></li>
        <li><a href="/intereses-profesionales/">Intereses</a></li>
        <li><a href="/ocio/">Ocio</a></li>
      </ul>
    </nav>

    <p>&copy; <time datetime="2026">2026</time> Manuel García Baldó. Todos los derechos reservados.</p>
  </footer>

  <script src="/js/main.js" defer></script>
</body>

</html>